# Frontend (exposed to the browser — safe to be public)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-side only (never prefix with VITE_)

# Gemini — narrative text generation (has a free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face — image generation via Inference Providers.
# Gemini's image models have no free tier, so artwork runs on HF instead.
# Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# Optional overrides
# IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# HF_PROVIDER=auto        # or fal-ai, together, replicate, nebius
